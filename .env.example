# Neon PostgreSQL (required on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth v5 (required on Vercel)
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Local only — set to your dev origin:
AUTH_URL="http://localhost:3000"

# On Vercel Production/Preview:
#   1) AUTH_SECRET = same value as above (required)
#   2) AUTH_TRUST_HOST=true
#   3) Either OMIT AUTH_URL, OR set it to the exact deploy origin with NO path/quotes:
#        AUTH_URL=https://zenith-leeq-sooty.vercel.app
#      Do NOT leave AUTH_URL=http://localhost:3000 on Vercel.

# Vercel Blob (optional — omit key if unused)
BLOB_READ_WRITE_TOKEN=""

# Resend (optional — omit keys if unused)
RESEND_API_KEY=""
EMAIL_FROM="ARC Tracker <onboarding@resend.dev>"

# Seed only (local / one-off scripts — not required at Vercel runtime)
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ELDER_PASSWORD="zenith2026!"
