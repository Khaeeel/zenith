# Neon PostgreSQL (required on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth v5 (required on Vercel)
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_SECRET is also accepted as a fallback for AUTH_SECRET

# Local only — set to your dev origin (no trailing path):
AUTH_URL="http://localhost:3000"

# On Vercel Production/Preview:
#   1) AUTH_SECRET = same value as above (required) — or NEXTAUTH_SECRET
#   2) AUTH_TRUST_HOST=true
#   3) AUTH_URL: DELETE the variable, OR set EXACTLY (no quotes in Vercel UI):
#        https://zenith-leeq-sooty.vercel.app
#      Do NOT set AUTH_URL to empty, localhost, or wrap in quotes.
#      If omitted, the app falls back to https://$VERCEL_URL.

# Vercel Blob (optional — omit key if unused)
BLOB_READ_WRITE_TOKEN=""

# Resend (optional — omit keys if unused)
RESEND_API_KEY=""
EMAIL_FROM="ARC Tracker <onboarding@resend.dev>"

# Seed only (local / one-off scripts — not required at Vercel runtime)
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ELDER_PASSWORD="zenith2026!"
